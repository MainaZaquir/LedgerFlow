{
  "name": "ledgerflow",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic payment processing, double-entry ledger, and reconciliation API",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration tests/api --maxWorkers=1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:key": "node --env-file=.env --import tsx scripts/issue-key.ts",
    "db:reset": "prisma migrate reset",
    "workflow": "node --env-file=.env --import tsx scripts/demo-workflow.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "csv-parse": "7.0.3",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "pino": "9.9.5",
    "pino-http": "10.5.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.23",
    "@types/node": "22.15.30",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.35.1",
    "@typescript-eslint/parser": "8.35.1",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "supertest": "7.1.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "4.1.12"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "qs": "6.16.2",
    "deepmerge-ts": "8.0.1"
  }
}
