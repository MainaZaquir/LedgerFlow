{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022"], "rootDir": ".", "outDir": "dist", "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true, "useUnknownInCatchVariables": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true, "resolveJsonModule": true, "types": ["node"]
  },
  "include": ["src", "tests", "prisma/seed.ts", "scripts", "vitest.config.ts"]
}
